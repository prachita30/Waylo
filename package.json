{
  "name": "waylo",
  "private": true,
  "version": "0.1.0",
  "description": "WAYLO — discounted airline offers and shared airport rides",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @waylo/api",
    "dev:web": "npm run dev --workspace @waylo/web",
    "db:generate": "npm run db:generate --workspace @waylo/api",
    "db:migrate": "npm run db:migrate --workspace @waylo/api",
    "db:seed": "npm run db:seed --workspace @waylo/api",
    "db:reset": "npm run db:reset --workspace @waylo/api",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.e2e.json",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run audit:brand",
    "audit:brand": "node scripts/brand-audit.mjs",
    "test:e2e": "playwright test"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "type": "module"
}
