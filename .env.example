# Copy to .env and adjust. Never commit real credentials.

# development | test | production
NODE_ENV=development
# demo: sandbox integrations allowed and labelled in the UI.
# production: the API refuses to start if any integration is still a sandbox.
WAYLO_MODE=demo

PORT=4000
# Comma-separated list of allowed browser origins (CORS + CSRF origin check).
WEB_ORIGIN=http://localhost:5173

# Managed PostgreSQL. Leave unset in development to use the embedded PGlite database
# stored in apps/api/.data/pglite. Required when NODE_ENV=production.
# DATABASE_URL=postgres://waylo:password@localhost:5432/waylo
PGLITE_DIR=.data/pglite

SESSION_TTL_HOURS=336
# Defaults to true in production. Set false only for local HTTP testing.
# COOKIE_SECURE=false
# Set true when running behind a reverse proxy / load balancer that terminates TLS.
TRUST_PROXY=false
LOG_LEVEL=info

# Shared secret used to verify payment webhooks (min 16 chars). The sandbox payment
# provider signs its webhooks with this value too.
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret-change-me

UPLOAD_DIR=.data/uploads
